# Large File Bridge CLI — task runner (pm/cli.mdx §1.3). `just build` / `just run …` work here,
# and the ROOT justfile's build/run also build this CLI so it is never stale.
#
# Portable on macOS, Linux and Windows — same three rules as the root justfile: no shell built-ins or
# Unix tools in a recipe, no comment lines inside a recipe body, no shebang recipes.

set shell := ["bash", "-uc"]
set windows-shell := ["cmd.exe", "/d", "/c"]

code := justfile_directory() / "code"
shim := justfile_directory() / "lfb.mjs"

default:
    @just --list

# Install deps + compile the CLI to code/dist/.
build:
    pnpm -C "{{code}}" install
    pnpm -C "{{code}}" build

# Typecheck only (no emit).
typecheck:
    pnpm -C "{{code}}" install
    pnpm -C "{{code}}" typecheck

# Build, then run the CLI with the given arguments (e.g. `just run files --all --compress`).
run *args: build
    @node "{{shim}}" {{args}}
