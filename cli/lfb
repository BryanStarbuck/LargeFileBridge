#!/usr/bin/env bash
# Large File Bridge CLI — POSIX entry point (pm/cli.mdx §1.1). The shim itself is lfb.mjs, in Node, so
# Windows has one too (lfb.cmd beside it); this only keeps `./lfb …` working from a shell.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec node "$DIR/lfb.mjs" "$@"
